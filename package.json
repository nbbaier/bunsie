{
  "name": "bunsie-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build:cli": "bun run --filter=bunsie build",
    "clean:cli": "bun run --filter=bunsie clean",
    "build:example": "bun run --filter=example build"
  },
  "module": "index.ts",
  "type": "module"
}
