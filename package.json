{
  "name": "bunsie-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "npm:@typescript/typescript6",
    "ultracite": "7.7.0"
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsgo --noEmit",
    "build:cli": "bun run --filter=bunsie build",
    "clean:cli": "bun run --filter=bunsie clean",
    "build:example": "bun run --filter=example build"
  },
  "module": "index.ts",
  "type": "module"
}
